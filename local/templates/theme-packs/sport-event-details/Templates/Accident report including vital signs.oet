    <definition archetype_id="openEHR-EHR-COMPOSITION.encounter.v1" concept_name="Encounter" name="Accident report including vital signs" xmlns:tem="openEHR/v1/Template" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="tem:COMPOSITION">
        <Content archetype_id="openEHR-EHR-EVALUATION.problem_diagnosis.v1" path="/content" xsi:type="tem:EVALUATION">
            <Rule name="Injury" path="/data[at0001]/items[at0002]"/>
            <Rule path="/data[at0001]/items[at0012]">
                <constraint xsi:type="tem:textConstraint">
                    <includedValues>SNOMED-CT::6921000::right arm</includedValues>
                    <includedValues>SNOMED-CT::80768000::left arm</includedValues>
                    <includedValues>SNOMED-CT::62175007::right leg</includedValues>
                    <includedValues>SNOMED-CT::32153003::left leg</includedValues>
                </constraint>
            </Rule>
            <Rule max="0" path="/data[at0001]/items[at0003]"/>
            <Rule max="0" path="/data[at0001]/items[at0005]">
                <constraint xsi:type="tem:multipleConstraint">
                    <includedTypes>Coded_text</includedTypes>
                    <includedTypes>Text</includedTypes>
                </constraint>
            </Rule>
            <Rule max="0" path="/data[at0001]/items[at0072]"/>
            <Rule max="0" path="/data[at0001]/items[at0030]"/>
            <Rule max="0" path="/data[at0001]/items[at0073]">
                <constraint xsi:type="tem:multipleConstraint">
                    <includedTypes>Coded_text</includedTypes>
                    <includedTypes>Text</includedTypes>
                </constraint>
            </Rule>
            <Rule max="0" path="/data[at0001]/items[at0069]"/>
            <Rule max="0" path="/protocol[at0032]/items[at0070]"/>
            <Items archetype_id="openEHR-EHR-CLUSTER.anatomical_location.v1" max="1" path="/data[at0001]/items[at0039]" xsi:type="tem:CLUSTER">
                <Rule path="/items[at0001]">
                    <constraint xsi:type="tem:textConstraint">
                        <includedValues>SNOMED-CT::53120007::Arm (Upper limb structure)</includedValues>
                        <includedValues>SNOMED-CT::61685007::Leg (Lower limb structure)</includedValues>
                    </constraint>
                </Rule>
                <Rule path="/items[at0064]">
                    <constraint xsi:type="tem:multipleConstraint">
                        <includedTypes>Coded_text</includedTypes>
                        <includedTypes>Text</includedTypes>
                    </constraint>
                </Rule>
                <Rule path="/items[at0055]">
                    <constraint xsi:type="tem:multipleConstraint">
                        <includedTypes>Coded_text</includedTypes>
                        <includedTypes>Text</includedTypes>
                    </constraint>
                </Rule>
            </Items>
            <Items archetype_id="openEHR-EHR-CLUSTER.sport_event_details.v0" max="1" path="/protocol[at0032]/items[at0071]" xsi:type="tem:CLUSTER">
                <Rule path="/items[at0001]">
                    <constraint xsi:type="tem:textConstraint">
                        <includedValues>Vätternrundan</includedValues>
                        <includedValues>Halvvättern 150 km</includedValues>
                        <includedValues>Tjejvättern 100 km</includedValues>
                        <includedValues>Vätternrundan 100 km</includedValues>
                        <includedValues>MTB-Vättern</includedValues>
                        <includedValues>Minivättern</includedValues>
                    </constraint>
                </Rule>
                <Rule path="/items[at0006]/items[at0009]/items[at0010]">
                    <constraint xsi:type="tem:quantityConstraint"/>
                </Rule>
                <Rule path="/items[at0006]/items[at0009]/items[at0011]">
                    <constraint xsi:type="tem:quantityConstraint"/>
                </Rule>
            </Items>
        </Content>
        <Content archetype_id="openEHR-EHR-SECTION.adhoc.v1" concept_name="Ad hoc heading" max="1" name="Vital signs" path="/content" xsi:type="tem:SECTION">
            <Item archetype_id="openEHR-EHR-OBSERVATION.pulse_oximetry.v1" max="1" path="/items" xsi:type="tem:OBSERVATION">
                <Rule max="0" path="/data[at0001]/events[at0002]/data[at0003]/items[at0044]">
                    <constraint xsi:type="tem:quantityConstraint">
                        <unitMagnitude>
                            <unit>ml/dl</unit>
                            <minMagnitude>0.0</minMagnitude>
                            <includesMaximum>false</includesMaximum>
                            <includesMinimum>true</includesMinimum>
                        </unitMagnitude>
                    </constraint>
                </Rule>
                <Rule max="0" path="/data[at0001]/events[at0002]/data[at0003]/items[at0045]"/>
                <Rule max="0" path="/data[at0001]/events[at0002]/data[at0003]/items[at0046]"/>
                <Rule max="0" path="/data[at0001]/events[at0002]/data[at0003]/items[at0058]"/>
                <Rule max="0" path="/data[at0001]/events[at0002]/data[at0003]/items[at0036]"/>
                <Rule max="0" path="/data[at0001]/events[at0002]/state[at0014]/items[at0016]"/>
                <Rule max="0" path="/protocol[at0007]/items[at0061]"/>
                <Items archetype_id="openEHR-EHR-CLUSTER.inspired_oxygen.v1" max="1" path="/data[at0001]/events[at0002]/state[at0014]/items[at0015]" xsi:type="tem:CLUSTER">
                    <Rule path="/items[at0051]">
                        <constraint xsi:type="tem:quantityConstraint">
                            <unitMagnitude>
                                <unit>ml/min</unit>
                                <maxMagnitude>50000.0</maxMagnitude>
                                <minMagnitude>0.0</minMagnitude>
                                <includesMaximum>true</includesMaximum>
                                <includesMinimum>true</includesMinimum>
                            </unitMagnitude>
                            <unitMagnitude>
                                <unit>l/min</unit>
                                <maxMagnitude>50.0</maxMagnitude>
                                <minMagnitude>0.0</minMagnitude>
                                <includesMaximum>true</includesMaximum>
                                <includesMinimum>true</includesMinimum>
                            </unitMagnitude>
                        </constraint>
                    </Rule>
                    <Rule max="0" path="/items[at0052]"/>
                    <Rule max="0" path="/items[at0053]"/>
                    <Rule max="0" path="/items[at0054]"/>
                </Items>
            </Item>
            <Item archetype_id="openEHR-EHR-OBSERVATION.respiration.v2" max="1" path="/items" xsi:type="tem:OBSERVATION">
                <Rule max="0" path="/data[at0001]/events[at0002]/data[at0003]/items[at0024]"/>
                <Rule max="0" path="/data[at0001]/events[at0002]/data[at0003]/items[at0070]"/>
                <Rule max="0" path="/data[at0001]/events[at0002]/state[at0022]/items[at0065]"/>
                <Rule max="0" path="/data[at0001]/events[at0002]/state[at0022]/items[at0056]"/>
                <Items archetype_id="openEHR-EHR-CLUSTER.inspired_oxygen.v1" max="1" path="/data[at0001]/events[at0002]/state[at0022]/items[at0055]" xsi:type="tem:CLUSTER">
                    <Rule max="0" path="/items[at0052]"/>
                    <Rule max="0" path="/items[at0053]"/>
                    <Rule max="0" path="/items[at0054]"/>
                </Items>
            </Item>
            <Item archetype_id="openEHR-EHR-OBSERVATION.pulse.v2" max="1" path="/items" xsi:type="tem:OBSERVATION">
                <Rule max="0" path="/data[at0002]/events[at0003]/data[at0001]/items[at1030]"/>
                <Rule max="0" path="/data[at0002]/events[at0003]/data[at0001]/items[at1022]"/>
                <Rule max="0" path="/data[at0002]/events[at0003]/data[at0001]/items[at1023]"/>
                <Rule max="0" path="/data[at0002]/events[at0003]/data[at0001]/items[at1059]"/>
                <Rule max="0" path="/data[at0002]/events[at0003]/state[at0012]/items[at1018]"/>
                <Rule max="0" path="/data[at0002]/events[at1036]"/>
                <Rule name="structure" path="/data[at0002]/events[at1036]/data[at0001]"/>
                <Rule name="List" path="/data[at0002]/events[at1036]/state[at0012]"/>
                <Rule path="/protocol[at0010]/items[at1037]">
                    <constraint xsi:type="tem:multipleConstraint">
                        <includedTypes>Coded_text</includedTypes>
                        <includedTypes>Text</includedTypes>
                    </constraint>
                </Rule>
            </Item>
        </Content>
        <Content archetype_id="openEHR-EHR-SECTION.adhoc.v1" concept_name="Ad hoc heading" max="1" name="Calculated scales" path="/content" xsi:type="tem:SECTION">
            <Item archetype_id="openEHR-EHR-OBSERVATION.news2.v1" max="1" path="/items" xsi:type="tem:OBSERVATION">
                <Rule path="/data[at0001]/events[at0002]/data[at0003]/items[at0028]">
                    <constraint xsi:type="tem:countConstraint">
                        <maxMagnitude>20</maxMagnitude>
                        <minMagnitude>0</minMagnitude>
                        <includesMaximum>true</includesMaximum>
                        <includesMinimum>true</includesMinimum>
                    </constraint>
                </Rule>
            </Item>
        </Content>
    </definition>
