                                <term_definitions code="at0041">
                                    <items id="text">Additional information</items>
                                    <items id="description">Place for additional information required for local adaptations or adaptation to other reference models or formal requirements.</items>
                                    <items id="comment">For example: local information requirements or metadata for adaptation to FHIR.</items>
                                </term_definitions>
                                <term_definitions code="[mi_i]">
