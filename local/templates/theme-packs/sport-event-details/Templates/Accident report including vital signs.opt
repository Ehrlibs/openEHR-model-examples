                                </archetype_id>
                                <term_definitions code="at0000">
                                    <items id="text">Sport event</items>
                                    <items id="description">Details about a recreational sports event, usually a recurring major event open to the general public.</items>
                                </term_definitions>
                                <term_definitions code="at0001">
                                    <items id="text">Event name</items>
                                    <items id="description"></items>
                                </term_definitions>
                                <term_definitions code="at0003">
                                    <items id="text">Training experience</items>
                                    <items id="description"></items>
                                </term_definitions>
                                <term_definitions code="at0004">
                                    <items id="text">Number of previous participations in this event</items>
                                    <items id="description"></items>
                                </term_definitions>
                                <term_definitions code="at0005">
                                    <items id="text">Time after start</items>
                                    <items id="description">Relative time since the participant started the event, for statistical purposes.</items>
                                    <items id="comment">Absolute time (clock time) is not recorded here but often elsewhere, for example in an injury reporting form.</items>
                                </term_definitions>
                                <term_definitions code="at0006">
                                    <items id="text">Location</items>
                                    <items id="description"></items>
                                </term_definitions>
                                <term_definitions code="at0007">
                                    <items id="text">Distance from start</items>
                                    <items id="description"></items>
                                </term_definitions>
                                <term_definitions code="at0008">
                                    <items id="text">Address or description</items>
                                    <items id="description"></items>
                                </term_definitions>
