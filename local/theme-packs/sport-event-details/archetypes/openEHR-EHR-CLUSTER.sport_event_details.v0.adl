description
	original_author = <
		["date"] = <"2022-06-15">
		["name"] = <"Erik Sundvall">
		["organisation"] = <"Karolinska University hospital + Institute & Linköping University, Sweden">
		["email"] = <"erik.sundvall@regionstockholm.se">
	>
	lifecycle_state = <"unmanaged">
	details = <
		["de"] = <
			language = <[ISO_639-1::de]>
			purpose = <"Zur Erfassung von Details zu einem Teilnehmer (Trainingserfahrung) bei einer Freizeit-Sportveranstaltung und wo entlang der Strecke ein Ereignis, zum Beispiel ein Unfall, auftritt. Beispielsweise für Hausarztpraxen und Notaufnahmen, die Statistiken zur Unfallprävention sammeln.">
			keywords = <"Unfallort","Freizeitlauf","Sportveranstaltung">
			use = <"Als Ergänzung in Formularen wie Verletzungsmeldeformularen verwenden. An die für die Veranstaltung relevanten Angaben anpassen; bei einem Radrennen ist möglicherweise der Ort am wichtigsten, bei Mannschaftssport auf einem Spielfeld eher die Zeit seit Spielbeginn. In Templates Felder weglassen, die nicht zutreffen.">
		>
		["sv"] = <
			language = <[ISO_639-1::sv]>
			purpose = <"Att registrera detaljer om en delatgare (träningsvana) i ett motionslopp och var längs loppet en händelse, t.ex. olycka, inträffar. Exempelvis på vårdcentral och akutmottagning som vill samla statistik för att förebygga olyckor.">
			keywords = <"olycksplats","motionslopp","sportevent">
			use = <"Används som tillägg i t.ex. fomulär med skaderapportering. Anpassa efter vad som är intressant för evenemanget, i ett cykellopp är kanske platsen intressant och i lagsport på en spelplan kanske tid sedan matchstart är intressantare. I template, utelämna de fält som inte passar.">
		>
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record details about a participant (training experience) in a recreational sports event and where along the event route an incident, for example an accident, occurs. For example for primary care and emergency departments collecting statistics to prevent accidents.">
			keywords = <"accident location","recreational race","sport event">
			use = <"Use as a supplement in forms such as injury reporting forms. Adapt to what is relevant for the event; in a cycling race location may be most relevant, while in team sports on a pitch time since match start may be more relevant. In templates, omit fields that do not apply.">
		>
		["fr"] = <
			language = <[ISO_639-1::fr]>
			purpose = <"Pour enregistrer les détails concernant un participant (expérience d'entraînement) à un événement sportif récréatif et l'endroit le long du parcours où un incident, par exemple un accident, se produit. Par exemple pour les centres de soins primaires et les services d'urgence collectant des statistiques pour prévenir les accidents.">
			keywords = <"lieu de l'accident","course récréative","événement sportif">
			use = <"À utiliser en complément dans des formulaires tels que les formulaires de déclaration de blessure. Adapter à ce qui est pertinent pour l'événement ; dans une course cycliste, le lieu peut être le plus pertinent, tandis qu'en sport d'équipe sur un terrain, le temps écoulé depuis le début du match peut l'être davantage. Dans les modèles, omettre les champs qui ne s'appliquent pas.">
		>
		["es"] = <
			language = <[ISO_639-1::es]>
			purpose = <"Para registrar detalles sobre un participante (experiencia de entrenamiento) en un evento deportivo recreativo y dónde a lo largo del recorrido ocurre un incidente, por ejemplo un accidente. Por ejemplo, para atención primaria y servicios de urgencias que recopilan estadísticas para prevenir accidentes.">
			keywords = <"lugar del accidente","carrera recreativa","evento deportivo">
			use = <"Usar como complemento en formularios como formularios de reporte de lesiones. Adaptar a lo relevante para el evento; en una carrera ciclista puede ser más relevante el lugar, mientras que en deportes de equipo en un campo puede serlo el tiempo desde el inicio del partido. En plantillas, omitir los campos que no apliquen.">
		>
		["ca"] = <
			language = <[ISO_639-1::ca]>
			purpose = <"Per registrar detalls sobre un participant (experiència d'entrenament) en un esdeveniment esportiu recreatiu i on al llarg del recorregut es produeix un incident, per exemple un accident. Per exemple, per a l'atenció primària i serveis d'urgències que recopilen estadístiques per prevenir accidents.">
			keywords = <"lloc de l'accident","cursa recreativa","esdeveniment esportiu">
			use = <"Utilitzar com a complement en formularis com formularis de reportatge de lesions. Adaptar al que sigui rellevant per a l'esdeveniment; en una cursa ciclista pot ser més rellevant el lloc, mentre que en esports d'equip en un camp pot ser-ho el temps des de l'inici del partit. En plantilles, ometre els camps que no s'apliquin.">
		>
	>
	other_details = <
		["licence"] = <"This work is licensed under the Creative Commons Attribution-ShareAlike 4.0 International License. To view a copy of this license, visit http://creativecommons.org/licenses/by-sa/4.0/.">
