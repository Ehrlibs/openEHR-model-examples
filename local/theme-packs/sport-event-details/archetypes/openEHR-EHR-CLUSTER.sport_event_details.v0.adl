		["es"] = <
			items = <
				["at0000"] = <
					text = <"Evento deportivo">
					description = <"Detalles de un evento deportivo recreativo, normalmente un evento importante y recurrente abierto al público en general.">
				>
				["at0001"] = <
					text = <"Nombre del evento">
					description = <"">
				>
				["at0003"] = <
					text = <"Experiencia de entrenamiento">
					description = <"">
				>
				["at0004"] = <
					text = <"Número de participaciones anteriores en este evento">
					description = <"">
				>
				["at0005"] = <
					text = <"Tiempo tras la salida">
					description = <"Tiempo relativo desde que el participante inició el evento, con fines estadísticos.">
					comment = <"La hora absoluta (reloj) no se registra aquí, sino a menudo en otro lugar, por ejemplo en un formulario de reporte de lesiones.">
				>
				["at0006"] = <
					text = <"Lugar">
					description = <"">
				>
