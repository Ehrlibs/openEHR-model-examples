		["MD5-CAM-1.0.1"] = <"e9cd22b513f694a07ad9acc8d82d7dee">
		["build_uid"] = <"dc305afe-21cd-39a4-827d-d9e6cb0cd853">
		["ip_acknowledgements"] = <"This artefact includes content from SNOMED Clinical Terms® (SNOMED CT®) which is copyrighted material of the International Health Terminology Standards Development Organisation (IHTSDO). Where an implementation of this artefact makes use of SNOMED CT content, the implementer must have the appropriate SNOMED CT Affiliate license - for more information contact https://www.snomed.org/snomed-ct/get-snomed or info@snomed.org.">
	>

definition
	CLUSTER[at0000] matches {    -- Sport event
		items cardinality matches {1..*; unordered} matches {
			ELEMENT[at0001] occurrences matches {0..1} matches {    -- Event name
				value matches {
					DV_TEXT matches {*}
				}
			}
			ELEMENT[at0030] matches {    -- Type of exercise/sport
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0031,    -- Cycling
							at0032,    -- Running
							at0033,    -- Skiing
							at0034]    -- Swimming
						}
					}
				}
			}
			ELEMENT[at0003] occurrences matches {0..1} matches {    -- Training experience
				value matches {
					DV_CODED_TEXT matches {
						defining_code matches {
							[local::
							at0016,    -- Beginner
							at0017,    -- Recreational athlete
							at0018]    -- Elite level
						}
					}
				}
			}
			ELEMENT[at0004] occurrences matches {0..1} matches {    -- Number of previous participations in this event
				value matches {
					DV_COUNT matches {
						magnitude matches {|>=0|}
					}
				}
			}
			ELEMENT[at0005] occurrences matches {0..1} matches {    -- Time after start
				value matches {
					DV_DURATION matches {*}
				}
			}
			CLUSTER[at0006] occurrences matches {0..1} matches {    -- Location
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0007] occurrences matches {0..1} matches {    -- Distance from start
						value matches {
							C_DV_QUANTITY <
								property = <[openehr::122]>
								list = <
									["1"] = <
										units = <"km">
									>
									["2"] = <
										units = <"m">
									>
									["3"] = <
										units = <"[mi_i]">
									>
								>
							>
						}
					}
					ELEMENT[at0008] occurrences matches {0..1} matches {    -- Address or description
						value matches {
							DV_TEXT matches {*}
						}
					}
					CLUSTER[at0009] occurrences matches {0..1} matches {    -- Position
						items cardinality matches {1..*; unordered} matches {
							ELEMENT[at0010] occurrences matches {0..1} matches {    -- Longitude
								value matches {
									C_DV_QUANTITY <
										property = <[openehr::497]>
										list = <
											["1"] = <
												units = <"deg">
											>
										>
									>
								}
							}
							ELEMENT[at0011] occurrences matches {0..1} matches {    -- Latitude
								value matches {
									C_DV_QUANTITY <
										property = <[openehr::497]>
										list = <
											["1"] = <
												units = <"deg">
											>
										>
									>
								}
							}
						}
					}
				}
			}
			CLUSTER[at0022] occurrences matches {0..1} matches {    -- Protective equipment worn on
				items cardinality matches {1..*; unordered} matches {
					ELEMENT[at0026] occurrences matches {0..1} matches {    -- Head
						value matches {
							DV_BOOLEAN matches {*}
							DV_CODED_TEXT matches {
								defining_code matches {
									[local::
									at0036,    -- No protection or headwear
									at0037,    -- Helmet
									at0038,    -- Cap
									at0039]    -- Hat
								}
							}
						}
					}
					ELEMENT[at0040] occurrences matches {0..1} matches {    -- Feet
						value matches {
							DV_CODED_TEXT matches {*}
							DV_BOOLEAN matches {*}
						}
					}
					ELEMENT[at0027] occurrences matches {0..1} matches {    -- Hands
						value matches {
							DV_CODED_TEXT matches {*}
							DV_BOOLEAN matches {*}
						}
					}
					ELEMENT[at0028] occurrences matches {0..1} matches {    -- Joints
						value matches {
							DV_CODED_TEXT matches {*}
							DV_BOOLEAN matches {*}
						}
					}
				}
			}
			allow_archetype CLUSTER[at0041] occurrences matches {0..*} matches {    -- Additional information
				include
					archetype_id/value matches {/.*/}
			}
		}
	}

